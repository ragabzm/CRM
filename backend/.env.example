APP_NAME="Ragab CRM API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One JSON object per line on stdout. See config/logging.php.
LOG_CHANNEL=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18.6 — chosen for trigram / tsvector search in later epics.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ragab
DB_USERNAME=ragab
DB_PASSWORD=ragab

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Database driver only: this system runs no message broker.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Base URI for RFC 9457 problem `type` members.
PROBLEM_TYPE_BASE_URI=https://errors.ragab-crm

# Which process the container runs: web | worker | scheduler (see docker/entrypoint.sh).
APP_PROCESS=web
